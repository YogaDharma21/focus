{
    "name": "focus-desktop",
    "version": "0.0.1",
    "private": true,
    "main": "electron/main.cjs",
    "type": "module",
    "scripts": {
        "dev": "concurrently \"vite\" \"npx wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
        "dev:electron": "electron .",
        "build": "tsc && vite build && tsc -p tsconfig.node.json",
        "preview": "vite preview",
        "electron": "cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
        "typecheck": "tsc --noEmit",
        "dist": "npm run build && electron-builder --win"
    },
    "dependencies": {
        "clsx": "^2.1.1",
        "date-fns": "^4.1.0",
        "lucide-react": "^1.30.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "tailwind-merge": "^3.0.1",
        "zustand": "^5.0.3"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "@types/node": "^22.13.0",
        "@types/react": "^19.0.8",
        "@types/react-dom": "^19.0.3",
        "@vitejs/plugin-react": "^4.3.4",
        "concurrently": "^9.1.2",
        "cross-env": "^7.0.3",
        "electron": "^34.2.0",
        "electron-builder": "^26.15.3",
        "tailwindcss": "^4.0.0",
        "typescript": "^5.7.3",
        "vite": "^6.1.0",
        "wait-on": "^7.2.0"
    },
    "build": {
        "appId": "com.yogacode.focus-desktop",
        "productName": "Focus Desktop",
        "directories": {
            "output": "dist/release"
        },
        "files": [
            "dist/**/*",
            "electron/**/*",
            "public/**/*"
        ],
        "win": {
            "target": "nsis",
            "icon": "public/icon.png"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true
        }
    }
}
