{
  "manifest_version": 3,
  "name": "Focus Distraction Shield",
  "version": "0.0.1",
  "description": "Browser extension for Pomodoro focus timers, site blocking, task tracking, and ambient audio.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "notifications",
    "alarms",
    "activeTab",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Focus Extension",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": ["blocked.html", "offscreen.html", "assets/*", "icons/*", "music1.mp3", "soundeffect.mp3"],
      "matches": ["<all_urls>"]
    }
  ]
}
