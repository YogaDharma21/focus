# Dockerfile for Landing Page (apps/landing)
FROM node:22-alpine AS builder
WORKDIR /app

RUN corepack enable

# Copy workspace definition and packages
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json ./
COPY packages/ ./packages/
COPY apps/landing/package.json ./apps/landing/

RUN pnpm install --filter @focus/landing... --frozen-lockfile

# Copy landing source code
COPY apps/landing ./apps/landing
RUN pnpm turbo run build --filter=@focus/landing

# Runner stage
FROM node:22-alpine AS runner
WORKDIR /app/apps/landing

ENV NODE_ENV=production
ENV PORT=3001

COPY --from=builder /app/apps/landing/package.json ./
COPY --from=builder /app/apps/landing/.next ./.next
COPY --from=builder /app/apps/landing/public ./public
COPY --from=builder /app/node_modules /app/node_modules
COPY --from=builder /app/apps/landing/node_modules ./node_modules

EXPOSE 3001

CMD ["pnpm", "run", "start", "--", "-p", "3001"]
