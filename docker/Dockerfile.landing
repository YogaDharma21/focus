# Dockerfile for Landing Page (apps/landing)
FROM node:22-alpine AS builder
WORKDIR /app

# Copy landing package files
COPY apps/landing/package*.json ./apps/landing/
WORKDIR /app/apps/landing
RUN npm install

# Copy landing source code
COPY apps/landing ./
RUN npm run build

# Runner stage
FROM node:22-alpine AS runner
WORKDIR /app/apps/landing

ENV NODE_ENV=production
ENV PORT=3001

COPY --from=builder /app/apps/landing/package*.json ./
COPY --from=builder /app/apps/landing/.next ./.next
COPY --from=builder /app/apps/landing/public ./public
COPY --from=builder /app/apps/landing/node_modules ./node_modules

EXPOSE 3001

CMD ["npm", "run", "start", "--", "-p", "3001"]
